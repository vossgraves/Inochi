# --- Database (Neon) ---
# Neon pooler connection string, e.g.
# postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/inochi?sslmode=require
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Discord bot ---
DISCORD_TOKEN=your-bot-token
# Comma separated application IDs that own the slash commands
DISCORD_CLIENT_ID=your-application-id

# --- Dashboard API ---
# Port for the axum API server
API_PORT=8080
# Bearer token the dashboard must send as `Authorization: Bearer <token>`
ADMIN_TOKEN=change-me-to-a-long-random-string
# Public URL of the dashboard (CORS allowlist, comma separated)
DASHBOARD_ORIGIN=http://localhost:5173

# --- Dashboard build ---
VITE_API_BASE=http://localhost:8080
